skyeseller.online {
	encode gzip zstd
	reverse_proxy skye:3000
}

www.skyeseller.online {
	redir https://skyeseller.online{uri} permanent
}

dashboard.skyeseller.online {
	encode gzip zstd
	reverse_proxy dashboard:80
}

# Wildcard for merchant storefronts (Next.js).
# Issued via DNS-01 against Cloudflare so a single cert covers every subdomain.
*.skyeseller.online {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	encode gzip zstd
	reverse_proxy storefront:3000
}
